# Copy this file to ".env.remote" and fill in the credentials from your
# FREE remote MySQL host (FreeSQLDatabase.com / db4free.net).
# This file is gitignored and NEVER committed.
REMOTE_DB_HOST=db.freemysqldatabase.com
REMOTE_DB_PORT=3306
REMOTE_DB_USER=your_remote_user
REMOTE_DB_PASSWORD=your_remote_password
REMOTE_DB_NAME=your_remote_db_name
